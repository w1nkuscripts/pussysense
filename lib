        sec.OutRect.Visible, sec.InRect.Visible, sec.BgRect.Visible, sec.TitleText.Visible = false, false, false, false
        for _, g in ipairs(sec.Glow) do g.Obj.Visible = false end
        for _, it in ipairs(sec.Items) do HideItem(it) end
    end

    local function GetItemTotalHeight(it)
        local h = it.Height + 4
        if it.Type == "Checkbox" and it.State and it.SubItems then
            for _, sub in ipairs(it.SubItems) do
                h = h + GetItemTotalHeight(sub)
            end
        elseif it.Type == "Dropdown" and it.ConditionalSubs and it.ConditionalSubs[it.Selected] then
            for _, sub in ipairs(it.ConditionalSubs[it.Selected]) do
                h = h + GetItemTotalHeight(sub)
            end
        end
        return h
    end

    local function RenderSide(sideList, scrollOffset)
        local clipTop = MenuY + ViewTop
        local clipBottom = MenuY + ViewBottom
        local curY = ViewTop - (scrollOffset or 0)

        for _, sec in ipairs(sideList) do
            local secH = 28
            for _, it in ipairs(sec.Items) do
                secH = secH + GetItemTotalHeight(it)
            end
            secH = secH + 6

            local absX = MenuX + sec.RelX
            local absY = MenuY + curY
            sec.AbsX, sec.AbsY = absX, absY
            sec.H = secH

            local renderTop = math.max(absY, clipTop)
            local renderBottom = math.min(absY + secH, clipBottom)
            local renderHeight = renderBottom - renderTop

            local isSecVisible = (renderHeight > 6) and (absY < clipBottom) and (absY + secH > clipTop)

            if isSecVisible then
                sec.OutRect.Position = Vector2.new(absX, renderTop)
                sec.OutRect.Size     = Vector2.new(sec.W, renderHeight)
                sec.InRect.Position  = Vector2.new(absX + 1, renderTop + 1)
                sec.InRect.Size      = Vector2.new(sec.W - 2, math.max(0, renderHeight - 2))
                sec.BgRect.Position  = Vector2.new(absX + 2, renderTop + 2)
                sec.BgRect.Size      = Vector2.new(sec.W - 4, math.max(0, renderHeight - 4))

                sec.OutRect.Visible, sec.InRect.Visible, sec.BgRect.Visible = true, true, true

                local glowVis = (absY >= clipTop - 2) and (absY <= clipBottom - 10)
                for _, g in ipairs(sec.Glow) do
                    g.Obj.Position = Vector2.new(absX + sec.GlowRelOffsetX + g.RelX, absY + 2)
                    g.Obj.Visible = glowVis
                end

                local titleVis = (absY + 8 >= clipTop) and (absY + 22 <= clipBottom)
                sec.TitleText.Position = Vector2.new(absX + 10, absY + 8)
                sec.TitleText.Visible = titleVis
            else
                sec.OutRect.Visible, sec.InRect.Visible, sec.BgRect.Visible, sec.TitleText.Visible = false, false, false, false
                for _, g in ipairs(sec.Glow) do g.Obj.Visible = false end
            end

            local itemY = absY + 28

            local function DrawItemRecursive(it, indent)
                local ix = absX + 10 + indent
                local iy = itemY
                local iw = sec.W - 20 - indent
                it.AbsX, it.AbsY, it.AbsW = ix, iy, iw

                local itemTotalH = it.Height + 4
                local isItemVisible = isSecVisible and (iy >= clipTop) and (iy + itemTotalH <= clipBottom - 2)

                if it.Type == "Checkbox" then
                    if isItemVisible then
                        local bSz = it.IsSub and 10 or 12
                        it.BoxOut.Position  = Vector2.new(ix, iy + 3)
                        it.BoxOut.Size      = Vector2.new(bSz, bSz)
                        it.BoxIn.Position   = Vector2.new(ix + 1, iy + 4)
                        it.BoxIn.Size       = Vector2.new(bSz - 2, bSz - 2)
                        it.BoxFill.Position = Vector2.new(ix + 2, iy + 5)
                        it.BoxFill.Size     = Vector2.new(bSz - 4, bSz - 4)
                        it.Txt.Position     = Vector2.new(ix + bSz + 6, iy + 1)
                        it.BoxOut.Visible, it.BoxIn.Visible, it.BoxFill.Visible, it.Txt.Visible = true, true, true, true

                        local rightEdge = ix + iw

                        if it.Picker then
                            local pw, ph = 18, 10
                            local px = rightEdge - pw
                            it.Picker.BoxOut.Position  = Vector2.new(px, iy + 4)
                            it.Picker.BoxOut.Size      = Vector2.new(pw, ph)
                            it.Picker.BoxIn.Position   = Vector2.new(px + 1, iy + 5)
                            it.Picker.BoxIn.Size       = Vector2.new(pw - 2, ph - 2)
                            it.Picker.BoxFill.Position = Vector2.new(px + 2, iy + 6)
                            it.Picker.BoxFill.Size     = Vector2.new(pw - 4, ph - 4)
                            it.Picker.BoxX, it.Picker.BoxY, it.Picker.BoxW, it.Picker.BoxH = px, iy + 4, pw, ph
                            it.Picker.BoxOut.Visible, it.Picker.BoxIn.Visible, it.Picker.BoxFill.Visible = true, true, true
                            rightEdge = px - 6
                        end

                        if it.HasBind and it.BindBtn then
                            local bText = it.Listening and "[ ... ]" or ("[ " .. FormatKeyName(it.BindKey) .. " ]")
                            it.BindBtn.Text = bText
                            local bw = math.max(24, math.floor(it.BindBtn.TextBounds.X))
                            local bx = rightEdge - bw
                            it.BindBtn.Position = Vector2.new(bx, iy + 1)
                            it.BindBtnX, it.BindBtnY, it.BindBtnW, it.BindBtnH = bx, iy + 1, bw, 16
                            it.BindBtn.Color = it.Listening and Library.Theme.TextActive or Library.Theme.TextDim
                            it.BindBtn.Visible = true
                        end
                    else
                        it.BoxOut.Visible, it.BoxIn.Visible, it.BoxFill.Visible, it.Txt.Visible = false, false, false, false
                        if it.BindBtn then it.BindBtn.Visible = false end
                        if it.Picker then
                            it.Picker.BoxX = nil
                            it.Picker.BoxOut.Visible, it.Picker.BoxIn.Visible, it.Picker.BoxFill.Visible = false, false, false
                        end
                    end

                    itemY = itemY + it.Height + 4

                    if it.State and it.SubItems then
                        for _, sub in ipairs(it.SubItems) do
                            DrawItemRecursive(sub, indent + 12)
                        end
                    elseif it.SubItems then
                        for _, sub in ipairs(it.SubItems) do HideItem(sub) end
                    end

                elseif it.Type == "Keybind" then
                    if isItemVisible then
                        it.Txt.Position = Vector2.new(ix, iy + 1)
                        it.Txt.Visible  = true

                        local bText = it.Listening and "[ ... ]" or ("[ " .. FormatKeyName(it.BindKey) .. " ]")
                        it.BindBtn.Text = bText
                        local bw = math.max(28, math.floor(it.BindBtn.TextBounds.X))
                        local bx = ix + iw - bw
                        it.BindBtn.Position = Vector2.new(bx, iy + 1)
                        it.BindBtnX, it.BindBtnY, it.BindBtnW, it.BindBtnH = bx, iy + 1, bw, 16
                        it.BindBtn.Color = Library.Theme.TextActive
                        it.BindBtn.Visible = true
                    else
                        it.Txt.Visible, it.BindBtn.Visible = false, false
                    end
                    itemY = itemY + it.Height + 4

                elseif it.Type == "ScrollList" then
                    local boxH = it.Height - 4
                    if isItemVisible then
                        it.BoxOut.Position = Vector2.new(ix, iy + 2)
                        it.BoxOut.Size     = Vector2.new(iw, boxH)
                        it.BoxIn.Position  = Vector2.new(ix + 1, iy + 3)
                        it.BoxIn.Size      = Vector2.new(iw - 2, boxH - 2)
                        it.BoxBg.Position  = Vector2.new(ix + 2, iy + 4)
                        it.BoxBg.Size      = Vector2.new(iw - 4, boxH - 4)
                        it.BoxOut.Visible, it.BoxIn.Visible, it.BoxBg.Visible = true, true, true

                        local rowY = iy + 6
                        local maxDisplay = math.floor((boxH - 8) / 16)
                        local startIdx = it.ScrollIndex or 1

                        for rIdx, row in ipairs(it.Rows) do
                            local realIdx = rIdx - startIdx + 1
                            if realIdx >= 1 and realIdx <= maxDisplay and (rowY + 14 <= iy + boxH) then
                                row.AbsX, row.AbsY, row.AbsW, row.AbsH = ix + 4, rowY, iw - 8, 16
                                row.Txt.Position = Vector2.new(ix + 8, rowY)
                                local isSel = (row.Name == it.Selected)
                                row.Txt.Text  = "> " .. row.Name
                                row.Txt.Color = isSel and Library.Theme.TextActive or Library.Theme.TextDim
                                row.Txt.Visible = true
                                rowY = rowY + 16
                            else
                                row.AbsX = nil
                                row.Txt.Visible = false
                            end
                        end
                    else
                        it.BoxOut.Visible, it.BoxIn.Visible, it.BoxBg.Visible = false, false, false
                        for _, row in ipairs(it.Rows) do
                            row.AbsX = nil
                            row.Txt.Visible = false
                        end
                    end
                    itemY = itemY + it.Height + 4

                elseif it.Type == "ButtonRow" then
                    local numBtns = #it.Buttons
                    local spacing = 6
                    local btnW = math.floor((iw - spacing * (numBtns - 1)) / numBtns)
                    local curBx = ix

                    for _, btn in ipairs(it.Buttons) do
                        if isItemVisible then
                            btn.AbsX, btn.AbsY, btn.AbsW, btn.AbsH = curBx, iy + 2, btnW, 20
                            btn.BoxOut.Position = Vector2.new(curBx, iy + 2)
                            btn.BoxOut.Size     = Vector2.new(btnW, 20)
                            btn.BoxIn.Position  = Vector2.new(curBx + 1, iy + 3)
                            btn.BoxIn.Size      = Vector2.new(btnW - 2, 18)
                            btn.BoxBg.Position  = Vector2.new(curBx + 2, iy + 4)
                            btn.BoxBg.Size      = Vector2.new(btnW - 4, 16)
                            btn.Txt.Position    = Vector2.new(curBx + math.floor(btnW / 2), iy + 4)
                            btn.BoxOut.Visible, btn.BoxIn.Visible, btn.BoxBg.Visible, btn.Txt.Visible = true, true, true, true
                        else
                            btn.AbsX = nil
                            btn.BoxOut.Visible, btn.BoxIn.Visible, btn.BoxBg.Visible, btn.Txt.Visible = false, false, false, false
                        end
                        curBx = curBx + btnW + spacing
                    end
                    itemY = itemY + it.Height + 4

                elseif it.Type == "Button" then
                    if isItemVisible then
                        it.BoxOut.Position = Vector2.new(ix, iy + 2)
                        it.BoxOut.Size     = Vector2.new(iw, 20)
                        it.BoxIn.Position  = Vector2.new(ix + 1, iy + 3)
                        it.BoxIn.Size      = Vector2.new(iw - 2, 18)
                        it.BoxBg.Position  = Vector2.new(ix + 2, iy + 4)
                        it.BoxBg.Size      = Vector2.new(iw - 4, 16)
                        it.Txt.Position    = Vector2.new(ix + math.floor(iw / 2), iy + 4)
                        it.BoxOut.Visible, it.BoxIn.Visible, it.BoxBg.Visible, it.Txt.Visible = true, true, true, true
                    else
                        it.BoxOut.Visible, it.BoxIn.Visible, it.BoxBg.Visible, it.Txt.Visible = false, false, false, false
                    end
                    itemY = itemY + it.Height + 4

                elseif it.Type == "Textbox" then
                    local boxY = iy + 15
                    if isItemVisible then
                        it.LblTxt.Position = Vector2.new(ix, iy)
                        it.LblTxt.Visible  = true
                        it.BoxOut.Position = Vector2.new(ix, boxY)
                        it.BoxOut.Size     = Vector2.new(iw, 18)
                        it.BoxIn.Position  = Vector2.new(ix + 1, boxY + 1)
                        it.BoxIn.Size      = Vector2.new(iw - 2, 16)
                        it.BoxBg.Position  = Vector2.new(ix + 2, boxY + 2)
                        it.BoxBg.Size      = Vector2.new(iw - 4, 14)

                        local displayStr = it.Text
                        if it.Focused then
                            displayStr = displayStr .. "_"
                        elseif #displayStr == 0 then
                            displayStr = "enter name..."
                        end
                        it.ValTxt.Text = displayStr
                        it.ValTxt.Color = (it.Focused or #it.Text > 0) and Library.Theme.TextWhite or Library.Theme.TextDim
                        it.ValTxt.Position = Vector2.new(ix + 6, boxY + 1)

                        it.BoxOut.Visible, it.BoxIn.Visible, it.BoxBg.Visible, it.ValTxt.Visible = true, true, true, true
                    else
                        it.LblTxt.Visible, it.BoxOut.Visible, it.BoxIn.Visible, it.BoxBg.Visible, it.ValTxt.Visible = false, false, false, false, false
                    end
                    itemY = itemY + it.Height + 4

                elseif it.Type == "ColorPicker" then
                    if isItemVisible then
                        it.Txt.Position = Vector2.new(ix, iy + 1)
                        it.Txt.Visible  = true
                        local bw, bh = 20, 12
                        local bx = ix + iw - bw
                        it.BoxOut.Position  = Vector2.new(bx, iy + 3)
                        it.BoxIn.Position   = Vector2.new(bx + 1, iy + 4)
                        it.BoxFill.Position = Vector2.new(bx + 2, iy + 5)
                        it.BoxX, it.BoxY, it.BoxW, it.BoxH = bx, iy + 3, bw, bh
                        it.BoxOut.Visible, it.BoxIn.Visible, it.BoxFill.Visible = true, true, true
                    else
                        it.BoxX = nil
                        it.Txt.Visible = false
                        it.BoxOut.Visible, it.BoxIn.Visible, it.BoxFill.Visible = false, false, false
                    end
                    itemY = itemY + it.Height + 4

                elseif it.Type == "Dropdown" then
                    local boxY = iy + 15
                    if isItemVisible then
                        it.LblTxt.Position = Vector2.new(ix, iy)
                        it.LblTxt.Visible  = true
                        it.BoxOut.Position = Vector2.new(ix, boxY)
                        it.BoxOut.Size     = Vector2.new(iw, 18)
                        it.BoxIn.Position  = Vector2.new(ix + 1, boxY + 1)
                        it.BoxIn.Size      = Vector2.new(iw - 2, 16)
                        it.BoxBg.Position  = Vector2.new(ix + 2, boxY + 2)
                        it.BoxBg.Size      = Vector2.new(iw - 4, 14)
                        it.ValTxt.Text     = it.Selected
                        it.ValTxt.Position = Vector2.new(ix + 6, boxY + 1)
                        it.ArrowTxt.Text   = it.Open and "^" or "v"
                        it.ArrowTxt.Position = Vector2.new(ix + iw - 12, boxY + 1)
                        it.BoxOut.Visible, it.BoxIn.Visible, it.BoxBg.Visible = true, true, true
                        it.ValTxt.Visible, it.ArrowTxt.Visible = true, true

                        for oIdx, opt in ipairs(it.OptItems) do
                            if it.Open then
                                local oy = boxY + 18 + (oIdx - 1) * 16
                                local isOptVis = (oy >= clipTop) and (oy + 16 <= clipBottom - 2)
                                if isOptVis then
                                    opt.AbsX, opt.AbsY, opt.AbsW, opt.AbsH = ix, oy, iw, 16
                                    opt.Out.Position = Vector2.new(ix, oy)
                                    opt.Out.Size     = Vector2.new(iw, 16)
                                    opt.In.Position  = Vector2.new(ix + 1, oy + 1)
                                    opt.In.Size      = Vector2.new(iw - 2, 14)
                                    opt.Bg.Position  = Vector2.new(ix + 2, oy + 2)
                                    opt.Bg.Size      = Vector2.new(iw - 4, 12)
                                    opt.Txt.Position = Vector2.new(ix + 6, oy)
                                    opt.Txt.Color    = (opt.Name == it.Selected) and Library.Theme.TextActive or Library.Theme.TextDim
                                    opt.Out.Visible, opt.In.Visible, opt.Bg.Visible, opt.Txt.Visible = true, true, true, true
                                else
                                    opt.AbsX = nil
                                    opt.Out.Visible, opt.In.Visible, opt.Bg.Visible, opt.Txt.Visible = false, false, false, false
                                end
                            else
                                opt.AbsX = nil
                                opt.Out.Visible, opt.In.Visible, opt.Bg.Visible, opt.Txt.Visible = false, false, false, false
                            end
                        end
                    else
                        it.LblTxt.Visible = false
                        it.BoxOut.Visible, it.BoxIn.Visible, it.BoxBg.Visible = false, false, false
                        it.ValTxt.Visible, it.ArrowTxt.Visible = false, false
                        for _, opt in ipairs(it.OptItems) do
                            opt.AbsX = nil
                            opt.Out.Visible, opt.In.Visible, opt.Bg.Visible, opt.Txt.Visible = false, false, false, false
                        end
                    end

                    itemY = itemY + it.Height + 4

                    if it.ConditionalSubs then
                        for optKey, subList in pairs(it.ConditionalSubs) do
                            if optKey == it.Selected then
                                for _, sub in ipairs(subList) do
                                    DrawItemRecursive(sub, indent + 8)
                                end
                            else
                                for _, sub in ipairs(subList) do HideItem(sub) end
                            end
                        end
                    end

                elseif it.Type == "Slider" then
                    if isItemVisible then
                        it.Txt.Position    = Vector2.new(ix, iy)
                        local vw = math.max(14, math.floor(it.ValTxt.TextBounds.X))
                        local rightEdge = ix + iw

                        if it.Picker then
                            local pw, ph = 18, 10
                            local px = rightEdge - pw
                            it.Picker.BoxOut.Position  = Vector2.new(px, iy + 2)
                            it.Picker.BoxOut.Size      = Vector2.new(pw, ph)
                            it.Picker.BoxIn.Position   = Vector2.new(px + 1, iy + 3)
                            it.Picker.BoxIn.Size       = Vector2.new(pw - 2, ph - 2)
                            it.Picker.BoxFill.Position = Vector2.new(px + 2, iy + 4)
                            it.Picker.BoxFill.Size     = Vector2.new(pw - 4, ph - 4)
                            it.Picker.BoxX, it.Picker.BoxY, it.Picker.BoxW, it.Picker.BoxH = px, iy + 2, pw, ph
                            it.Picker.BoxOut.Visible, it.Picker.BoxIn.Visible, it.Picker.BoxFill.Visible = true, true, true
                            rightEdge = px - 6
                        end

                        it.ValTxt.Position = Vector2.new(rightEdge - vw, iy)

                        local btnY = iy + 14
                        local barX = ix + 18
                        local barW = iw - 36
                        local barY = btnY + 3
                        it.BtnMinusOut.Position = Vector2.new(ix, btnY)
                        it.BtnMinusIn.Position  = Vector2.new(ix + 1, btnY + 1)
                        it.BtnMinusBg.Position  = Vector2.new(ix + 2, btnY + 2)
                        it.BtnMinusTxt.Position = Vector2.new(ix + 7, btnY)
                        it.BarOut.Position = Vector2.new(barX, barY)
                        it.BarOut.Size     = Vector2.new(barW, 8)
                        it.BarIn.Position  = Vector2.new(barX + 1, barY + 1)
                        it.BarIn.Size      = Vector2.new(barW - 2, 6)
                        local pct = math.clamp((it.Val - it.Min) / (it.Max - it.Min), 0, 1)
                        it.BarFill.Position = Vector2.new(barX + 1, barY + 1)
                        it.BarFill.Size     = Vector2.new(math.max(1, math.floor((barW - 2) * pct)), 6)
                        local plusX = ix + iw - 14
                        it.BtnPlusOut.Position = Vector2.new(plusX, btnY)
                        it.BtnPlusIn.Position  = Vector2.new(plusX + 1, btnY + 1)
                        it.BtnPlusBg.Position  = Vector2.new(plusX + 2, btnY + 2)
                        it.BtnPlusTxt.Position = Vector2.new(plusX + 7, btnY)
                        it.Txt.Visible, it.ValTxt.Visible = true, true
                        it.BtnMinusOut.Visible, it.BtnMinusIn.Visible, it.BtnMinusBg.Visible, it.BtnMinusTxt.Visible = true, true, true, true
                        it.BarOut.Visible, it.BarIn.Visible, it.BarFill.Visible = true, true, true
                        it.BtnPlusOut.Visible, it.BtnPlusIn.Visible, it.BtnPlusBg.Visible, it.BtnPlusTxt.Visible = true, true, true, true
                    else
                        if it.Picker then it.Picker.BoxX = nil end
                        it.Txt.Visible, it.ValTxt.Visible = false, false
                        it.BtnMinusOut.Visible, it.BtnMinusIn.Visible, it.BtnMinusBg.Visible, it.BtnMinusTxt.Visible = false, false, false, false
                        it.BarOut.Visible, it.BarIn.Visible, it.BarFill.Visible = false, false, false
                        it.BtnPlusOut.Visible, it.BtnPlusIn.Visible, it.BtnPlusBg.Visible, it.BtnPlusTxt.Visible = false, false, false, false
                    end
                    itemY = itemY + it.Height + 4
                end
            end

            for _, it in ipairs(sec.Items) do
                DrawItemRecursive(it, 0)
            end
            curY = curY + secH + 8
        end
    end

    local function CalculateContentHeight(sideList)
        local h = 0
        for _, sec in ipairs(sideList) do
            local secH = 28
            for _, it in ipairs(sec.Items) do
                secH = secH + GetItemTotalHeight(it)
            end
            h = h + secH + 6 + 8
        end
        return h
    end

    local function RefreshLayout()
        for tabName, p in pairs(Window.Pages) do
            if not Library.MenuOpen or tabName ~= Window.ActiveTab then
                for _, s in ipairs(p.Left) do HideSection(s) end
                for _, s in ipairs(p.Right) do HideSection(s) end
            end
        end
        if not Library.MenuOpen then return end

        local curPage = Window.Pages[Window.ActiveTab]
        if curPage then
            local availableH = ViewBottom - ViewTop
            local maxLeftScroll = math.max(0, CalculateContentHeight(curPage.Left) - availableH)
            local maxRightScroll = math.max(0, CalculateContentHeight(curPage.Right) - availableH)

            curPage.ScrollLeft = math.clamp(curPage.ScrollLeft or 0, 0, maxLeftScroll)
            curPage.ScrollRight = math.clamp(curPage.ScrollRight or 0, 0, maxRightScroll)

            RenderSide(curPage.Left, curPage.ScrollLeft)
            RenderSide(curPage.Right, curPage.ScrollRight)
        end
    end

    local function UpdateTabsGeometry()
        local totalW = 0
        local tabSpacing = 24

        for _, t in ipairs(Window.Tabs) do
            local textW = math.floor(t.Item.TextBounds.X)
            if textW <= 0 then textW = #t.Name * 7 end
            t.W = textW
            totalW = totalW + tabSpacing * (#Window.Tabs - 1)
        end

        local leftBound = 120
        local rightBound = MenuW - 20
        local availableSpace = rightBound - leftBound

        local startX = leftBound + math.floor((availableSpace - totalW) / 2)

        local curX = startX
        for _, t in ipairs(Window.Tabs) do
            t.RelX = curX
            t.Item.Position = Vector2.new(MenuX + curX, MenuY + 14)
            curX = curX + t.W + tabSpacing
        end

        if Window.ActiveTab then
            for _, t in ipairs(Window.Tabs) do
                if t.Name == Window.ActiveTab then
                    MoveActiveTabGlow(t.Item, t.RelX)
                    break
                end
            end
        end
    end

    local isDragging = false
    local dragOffset = Vector2.new(0, 0)
    local ActiveSlider = nil
    local ListeningBindItem = nil

    local function HandleItemInteraction(mPos, it)
        if it.AbsX == nil then return false end

        if it.Type == "Checkbox" then
            if it.Picker and it.Picker.BoxX and IsMouseOver(mPos, it.Picker.BoxX - 2, it.Picker.BoxY - 2, it.Picker.BoxW + 4, it.Picker.BoxH + 4) then
                CloseBindPopup()
                CloseColorMenuPopup()
                OpenColorPicker(it.Picker, it.Picker.BoxX + 26, it.Picker.BoxY - 20)
                return true
            end

            if it.HasBind and it.BindBtnX and IsMouseOver(mPos, it.BindBtnX - 4, it.BindBtnY - 2, it.BindBtnW + 8, it.BindBtnH + 4) then
                it.Listening = true
                ListeningBindItem = it
                RefreshLayout()
                return true
            end

            local clickZoneW = it.AbsW - (it.HasBind and 40 or 0) - (it.Picker and 26 or 0)
            if IsMouseOver(mPos, it.AbsX, it.AbsY - 4, clickZoneW, it.Height + 8) then
                it.State = not it.State
                it.BoxFill.Color = it.State and Library.Theme.TextActive or Library.Theme.ControlBg
                it.Txt.Color = it.State and Library.Theme.TextWhite or Library.Theme.TextDim
                if it.Callback then it.Callback(it.State) end
                RefreshLayout()
                return true
            end

            if it.State and it.SubItems then
                for _, sub in ipairs(it.SubItems) do
                    if HandleItemInteraction(mPos, sub) then return true end
                end
            end
        elseif it.Type == "Keybind" then
            if it.BindBtnX and IsMouseOver(mPos, it.BindBtnX - 4, it.BindBtnY - 2, it.BindBtnW + 8, it.BindBtnH + 4) then
                it.Listening = true
                ListeningBindItem = it
                RefreshLayout()
                return true
            end
        elseif it.Type == "ScrollList" then
            for _, row in ipairs(it.Rows) do
                if row.AbsX and IsMouseOver(mPos, row.AbsX, row.AbsY, row.AbsW, row.AbsH) then
                    it.Selected = row.Name
                    if it.Callback then it.Callback(row.Name) end
                    RefreshLayout()
                    return true
                end
            end
        elseif it.Type == "ButtonRow" then
            for _, btn in ipairs(it.Buttons) do
                if btn.AbsX and IsMouseOver(mPos, btn.AbsX, btn.AbsY, btn.AbsW, btn.AbsH) then
                    if btn.Callback then btn.Callback() end
                    return true
                end
            end
        elseif it.Type == "Button" then
            if IsMouseOver(mPos, it.AbsX, it.AbsY + 2, it.AbsW, 20) then
                if it.Callback then it.Callback() end
                return true
            end
        elseif it.Type == "Textbox" then
            if IsMouseOver(mPos, it.AbsX, it.AbsY + 14, it.AbsW, 20) then
                it.Focused = true
                ActiveTextbox = it
                RefreshLayout()
                return true
            end
        elseif it.Type == "ColorPicker" then
            if it.BoxX and IsMouseOver(mPos, it.BoxX - 2, it.BoxY - 2, it.BoxW + 4, it.BoxH + 4) then
                CloseBindPopup()
                CloseColorMenuPopup()
                OpenColorPicker(it, it.BoxX + 28, it.BoxY - 20)
                return true
            end
        elseif it.Type == "Dropdown" then
            if IsMouseOver(mPos, it.AbsX, it.AbsY + 14, it.AbsW, 20) then
                it.Open = not it.Open
                RefreshLayout()
                return true
            end
            if it.ConditionalSubs and it.ConditionalSubs[it.Selected] then
                for _, sub in ipairs(it.ConditionalSubs[it.Selected]) do
                    if HandleItemInteraction(mPos, sub) then return true end
                end
            end
        elseif it.Type == "Slider" then
            if it.Picker and it.Picker.BoxX and IsMouseOver(mPos, it.Picker.BoxX - 2, it.Picker.BoxY - 2, it.Picker.BoxW + 4, it.Picker.BoxH + 4) then
                CloseBindPopup()
                CloseColorMenuPopup()
                OpenColorPicker(it.Picker, it.Picker.BoxX + 26, it.Picker.BoxY - 20)
                return true
            end

            if IsMouseOver(mPos, it.AbsX, it.AbsY + 10, 18, 18) then
                it.Val = math.clamp(it.Val - it.Step, it.Min, it.Max)
                it.ValTxt.Text = it.Format(it.Val)
                if it.Callback then it.Callback(it.Val) end
                RefreshLayout()
                return true
            elseif IsMouseOver(mPos, it.AbsX + it.AbsW - 18, it.AbsY + 10, 18, 18) then
                it.Val = math.clamp(it.Val + it.Step, it.Min, it.Max)
                it.ValTxt.Text = it.Format(it.Val)
                if it.Callback then it.Callback(it.Val) end
                RefreshLayout()
                return true
            elseif IsMouseOver(mPos, it.AbsX + 16, it.AbsY + 10, it.AbsW - 32, 18) then
                ActiveSlider = it
                return true
            end
        end
        return false
    end

    local function HandleRightClickInteraction(mPos, it)
        if it.AbsX == nil then return false end

        if it.Type == "Keybind" then
            return false
        end

        if it.Type == "Checkbox" then
            if it.HasBind and it.BindBtnX and IsMouseOver(mPos, it.BindBtnX - 4, it.BindBtnY - 2, it.BindBtnW + 8, it.BindBtnH + 4) then
                CloseColorPicker()
                CloseColorMenuPopup()
                OpenBindPopup(it, mPos.X + 4, mPos.Y)
                return true
            elseif it.Picker and it.Picker.BoxX and IsMouseOver(mPos, it.Picker.BoxX - 2, it.Picker.BoxY - 2, it.Picker.BoxW + 4, it.Picker.BoxH + 4) then
                CloseColorPicker()
                CloseBindPopup()
                OpenColorMenuPopup(it.Picker, mPos.X + 4, mPos.Y)
                return true
            end
            if it.State and it.SubItems then
                for _, sub in ipairs(it.SubItems) do
                    if HandleRightClickInteraction(mPos, sub) then return true end
                end
            end
        elseif it.Type == "ColorPicker" then
            if it.BoxX and IsMouseOver(mPos, it.BoxX - 2, it.BoxY - 2, it.BoxW + 4, it.BoxH + 4) then
                CloseColorPicker()
                CloseBindPopup()
                OpenColorMenuPopup(it, mPos.X + 4, mPos.Y)
                return true
            end
        elseif it.Type == "Slider" and it.Picker then
            if it.Picker.BoxX and IsMouseOver(mPos, it.Picker.BoxX - 2, it.Picker.BoxY - 2, it.Picker.BoxW + 4, it.Picker.BoxH + 4) then
                CloseColorPicker()
                CloseBindPopup()
                OpenColorMenuPopup(it.Picker, mPos.X + 4, mPos.Y)
                return true
            end
        elseif it.Type == "Dropdown" and it.ConditionalSubs and it.ConditionalSubs[it.Selected] then
            for _, sub in ipairs(it.ConditionalSubs[it.Selected]) do
                if HandleRightClickInteraction(mPos, sub) then return true end
            end
        end
        return false
    end

    function Window:CreateTab(name)
        local tabName = string.lower(name)
        local btn = NewDraw("Text", {
            Text = tabName, Position = Vector2.new(0, 0), Size = 13, Font = Drawing.Fonts.Plex,
            Color = Library.Theme.TextDim, Outline = true, OutlineColor = Color3.new(0,0,0), Visible = true, ZIndex = 7
        })
        local bw = math.max(#tabName * 7, math.floor(btn.TextBounds.X))
        local tabData = { Name = tabName, Item = btn, RelX = 0, RelY = 14, W = bw, H = 18 }
        table.insert(Window.Tabs, tabData)
        Window.Pages[tabName] = { Left = {}, Right = {}, ScrollLeft = 0, ScrollRight = 0 }

        UpdateTabsGeometry()

        if not Window.ActiveTab then
            Window.ActiveTab = tabName
            btn.Color = Library.Theme.TextActive
            task.defer(function()
                UpdateTabsGeometry()
                RefreshLayout()
            end)
        end

        local TabObj = {}
        function TabObj:CreateSection(side, title)
            local targetSide = (string.lower(side) == "right") and "Right" or "Left"
            local sectionGlowW = ColWidth - 8
            local sec = {
                Title = title, Items = {},
                OutRect   = NewDraw("Square", { Color = Library.Theme.OuterBorder, Filled = true, Visible = false, ZIndex = 10 }),
                InRect    = NewDraw("Square", { Color = Library.Theme.InnerBorder, Filled = true, Visible = false, ZIndex = 11 }),
                BgRect    = NewDraw("Square", { Color = Library.Theme.SectionBg,   Filled = true, Visible = false, ZIndex = 12 }),
                TitleText = NewDraw("Text",   { Text = title, Size = 13, Font = Drawing.Fonts.Plex, Color = Library.Theme.TextWhite, Outline = true, OutlineColor = Color3.new(0,0,0), Visible = false, ZIndex = 15 }),
                Glow      = CreateHorizontalGlow(0, 0, sectionGlowW, 1, 13),
                GlowRelOffsetX = 4,
                RelX = (targetSide == "Left") and LeftColX or RightColX,
                W = ColWidth, H = 30
            }
            for _, g in ipairs(sec.Glow) do g.Obj.Visible = false end
            table.insert(Window.Pages[tabName][targetSide], sec)

            local SecObj = {}

            function SecObj:AddScrollList(label, items, height, callback)
                local listH = height or 220
                local item = {
                    Type = "ScrollList", Label = label, Selected = items and items[1] or "", ScrollIndex = 1, Height = listH, Callback = callback,
                    BoxOut = NewDraw("Square", { Color = Library.Theme.OuterBorder, Filled = true, Visible = false, ZIndex = 14 }),
                    BoxIn  = NewDraw("Square", { Color = Library.Theme.InnerBorder, Filled = true, Visible = false, ZIndex = 15 }),
                    BoxBg  = NewDraw("Square", { Color = Library.Theme.ControlBg,   Filled = true, Visible = false, ZIndex = 16 }),
                    Rows   = {}
                }

                function item:SetItems(newItems)
                    for _, r in ipairs(item.Rows) do
                        r.Txt.Visible = false
                        r.Txt:Remove()
                    end
                    item.Rows = {}
                    for _, str in ipairs(newItems) do
                        local txt = NewDraw("Text", {
                            Text = "> " .. str, Size = 13, Font = Drawing.Fonts.Plex,
                            Color = (str == item.Selected) and Library.Theme.TextActive or Library.Theme.TextDim,
                            Outline = true, Visible = false, ZIndex = 18
                        })
                        table.insert(item.Rows, { Name = str, Txt = txt })
                    end
                    RefreshLayout()
                end

                item:SetItems(items or {})
                table.insert(sec.Items, item)
                RefreshLayout()
                return item
            end

