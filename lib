    local function CreateHorizontalGlow(relX, relY, width, height, customZ)
        local segments = {}
        local z = customZ or 6
        local h = height or 1
        for x = 0, width - 1 do
            local p = (width > 1) and (x / (width - 1)) or 0.5
            local inten = (math.sin(p * math.pi)) ^ 2.2
            local col = (inten < 0.5)
                and Library.Theme.MainBg:Lerp(Library.Theme.GlowMid, inten * 1.8)
                or Library.Theme.GlowMid:Lerp(Library.Theme.GlowCore, (inten - 0.5) * 2)

            local line = NewDraw("Square", {
                Size = Vector2.new(1, h),
                Position = Vector2.new(MenuX + relX + x, MenuY + relY),
                Color = col, Filled = true, Visible = true, ZIndex = z
            })
            table.insert(segments, { Obj = line, RelX = relX + x, RelY = relY })
        end
        return segments
    end

