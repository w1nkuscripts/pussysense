local function NewDraw(class, props)
    local obj = Drawing.new(class)
    for k, v in pairs(props) do obj[k] = v end
    return obj
end

local function GetExactMouse()
    local raw = UserInputService:GetMouseLocation()
    return Vector2.new(raw.X, raw.Y + Library.MouseOffsetY)
end

local function IsMouseOver(m, x, y, w, h)
    return m.X >= x and m.X <= (x + w) and m.Y >= y and m.Y <= (y + h)
end

local function FormatKeyName(k)
    if not k then return "-" end
    local s = tostring(k)
    s = s:gsub("MouseButton1", "m1"):gsub("MouseButton2", "m2"):gsub("MouseButton3", "m3")
    s = s:gsub("RightShift", "rshift"):gsub("LeftShift", "lshift")
    return string.lower(s)
end

