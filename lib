    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            local mPos = GetExactMouse()
            local curPage = Window.Pages[Window.ActiveTab]
            if curPage and IsMouseOver(mPos, MenuX, MenuY + ViewTop, MenuW, ViewBottom - ViewTop) then
                for _, sideList in ipairs({ curPage.Left, curPage.Right }) do
                    for _, sec in ipairs(sideList) do
                        for _, it in ipairs(sec.Items) do
                            if it.Type == "ScrollList" and it.AbsX and IsMouseOver(mPos, it.AbsX, it.AbsY, it.AbsW, it.Height) then
                                local delta = -input.Position.Z
                                local maxRows = #it.Rows
                                local visibleRows = math.floor((it.Height - 8) / 16)
                                it.ScrollIndex = math.clamp((it.ScrollIndex or 1) + delta, 1, math.max(1, maxRows - visibleRows + 1))
                                RefreshLayout()
                                return
                            end
                        end
                    end
                end

                local scrollSpeed = 26
                local delta = -input.Position.Z * scrollSpeed
                local isRightSide = (mPos.X > MenuX + LeftColX + ColWidth)

                if isRightSide then
                    curPage.ScrollRight = (curPage.ScrollRight or 0) + delta
                else
                    curPage.ScrollLeft = (curPage.ScrollLeft or 0) + delta
                end
                RefreshLayout()
            end
        end
    end)

    UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == Library.MenuKey then
            Library.MenuOpen = not Library.MenuOpen
            fOuter.Visible = Library.MenuOpen
            fMid.Visible   = Library.MenuOpen
            fGap.Visible   = Library.MenuOpen
            fIn.Visible    = Library.MenuOpen
            fBg.Visible    = Library.MenuOpen
            headerSep.Visible = Library.MenuOpen
            tLogo1.Visible = Library.MenuOpen
            tLogo2.Visible = Library.MenuOpen
            for _, seg in ipairs(topBorderGlow) do seg.Obj.Visible = Library.MenuOpen end
            for _, seg in ipairs(botBorderGlow) do seg.Obj.Visible = Library.MenuOpen end
            for _, seg in ipairs(mainHeaderGlow) do seg.Obj.Visible = Library.MenuOpen end
            for _, tb in ipairs(Window.Tabs) do tb.Item.Visible = Library.MenuOpen end
            if not Library.MenuOpen then
                CloseBindPopup()
                CloseColorPicker()
                CloseColorMenuPopup()
            end
            RefreshLayout()
            return
        end

        if not Library.MenuOpen then return end

        if ActiveTextbox then
            if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.Escape then
                ActiveTextbox.Focused = false
                if ActiveTextbox.Callback then ActiveTextbox.Callback(ActiveTextbox.Text) end
                ActiveTextbox = nil
                RefreshLayout()
                return
            elseif input.KeyCode == Enum.KeyCode.Backspace then
                ActiveTextbox.Text = ActiveTextbox.Text:sub(1, -2)
                RefreshLayout()
                return
            elseif input.UserInputType == Enum.UserInputType.Keyboard then
                local char = UserInputService:GetStringForKeyCode(input.KeyCode)
                if char and #char > 0 then
                    local isShift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
                    if not isShift then char = string.lower(char) end
                    ActiveTextbox.Text = ActiveTextbox.Text .. char
                    RefreshLayout()
                    return
                end
            end
        end

        if ListeningBindItem then
            local keyName = nil
            if input.UserInputType == Enum.UserInputType.Keyboard then
                keyName = input.KeyCode.Name
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
                keyName = input.UserInputType.Name
            end
            if keyName then
                ListeningBindItem.BindKey = (keyName == "Escape" or keyName == "Backspace") and nil or keyName
                ListeningBindItem.Listening = false
                if ListeningBindItem.Callback then
                    ListeningBindItem.Callback(ListeningBindItem.BindKey)
                end
                ListeningBindItem = nil
                RefreshLayout()
                return
            end
        end

        local pressedInput = nil
        if input.UserInputType == Enum.UserInputType.Keyboard then
            pressedInput = input.KeyCode.Name
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
            pressedInput = input.UserInputType.Name
        end

        if pressedInput then
            for _, p in pairs(Window.Pages) do
                for _, sideList in ipairs({ p.Left, p.Right }) do
                    for _, sec in ipairs(sideList) do
                        for _, it in ipairs(sec.Items) do
                            if it.Type == "Checkbox" and it.BindKey == pressedInput then
                                if it.BindMode == "toggle" then
                                    it.State = not it.State
                                    it.BoxFill.Color = it.State and Library.Theme.TextActive or Library.Theme.ControlBg
                                    it.Txt.Color = it.State and Library.Theme.TextWhite or Library.Theme.TextDim
                                    if it.Callback then it.Callback(it.State) end
                                    RefreshLayout()
                                elseif it.BindMode == "hold" then
                                    it.State = true
                                    it.BoxFill.Color = Library.Theme.TextActive
                                    it.Txt.Color = Library.Theme.TextWhite
                                    if it.Callback then it.Callback(true) end
                                    RefreshLayout()
                                end
                            end
                        end
                    end
                end
            end
        end

        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            local mPos = GetExactMouse()
            local curPage = Window.Pages[Window.ActiveTab]
            if curPage then
                for _, sideList in ipairs({ curPage.Left, curPage.Right }) do
                    for _, sec in ipairs(sideList) do
                        for _, it in ipairs(sec.Items) do
                            if HandleRightClickInteraction(mPos, it) then return end
                        end
                    end
                end
            end
        end

        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local mPos = GetExactMouse()

            if ActiveTextbox and not IsMouseOver(mPos, ActiveTextbox.AbsX, ActiveTextbox.AbsY + 14, ActiveTextbox.AbsW, 20) then
                ActiveTextbox.Focused = false
                if ActiveTextbox.Callback then ActiveTextbox.Callback(ActiveTextbox.Text) end
                ActiveTextbox = nil
                RefreshLayout()
            end

            if ColorMenuPopup.Visible then
                if IsMouseOver(mPos, ColorMenuPopup.X, ColorMenuPopup.Y, ColorMenuPopup.W, ColorMenuPopup.H) then
                    if IsMouseOver(mPos, ColorMenuPopup.X, ColorMenuPopup.Y + 2, ColorMenuPopup.W, 14) then
                        if ColorMenuPopup.TargetColorItem then
                            Library.ClipboardColor = ColorMenuPopup.TargetColorItem.ColorVal
                        end
                        CloseColorMenuPopup()
                        return
                    elseif IsMouseOver(mPos, ColorMenuPopup.X, ColorMenuPopup.Y + 16, ColorMenuPopup.W, 14) then
                        if ColorMenuPopup.TargetColorItem and Library.ClipboardColor then
                            ColorMenuPopup.TargetColorItem.ColorVal = Library.ClipboardColor
                            ColorMenuPopup.TargetColorItem.BoxFill.Color = Library.ClipboardColor
                            if ColorMenuPopup.TargetColorItem.Callback then
                                ColorMenuPopup.TargetColorItem.Callback(Library.ClipboardColor)
                            end
                        end
                        CloseColorMenuPopup()
                        RefreshLayout()
                        return
                    end
                else
                    CloseColorMenuPopup()
                end
            end

            if ColorPickerWin.Visible then
                if IsMouseOver(mPos, ColorPickerWin.X, ColorPickerWin.Y, ColorPickerWin.W, ColorPickerWin.H) then
                    if IsMouseOver(mPos, ColorPickerWin.X + 8, ColorPickerWin.Y + 8, 110, 110) then
                        ColorPickerWin.DraggingSV = true
                        ColorPickerWin.S_Val = math.clamp((mPos.X - (ColorPickerWin.X + 8)) / 105, 0, 1)
                        ColorPickerWin.V_Val = 1 - math.clamp((mPos.Y - (ColorPickerWin.Y + 8)) / 105, 0, 1)
                        UpdateColorPickerVisuals(false)
                        return
                    elseif IsMouseOver(mPos, ColorPickerWin.X + 128, ColorPickerWin.Y + 8, 18, 100) then
                        ColorPickerWin.DraggingH = true
                        ColorPickerWin.H_Val = 1 - math.clamp((mPos.Y - (ColorPickerWin.Y + 8)) / 96, 0, 1)
                        UpdateColorPickerVisuals(true)
                        return
                    end
                    return
                else
                    CloseColorPicker()
                end
            end

            if BindPopup.Visible then
                if IsMouseOver(mPos, BindPopup.X, BindPopup.Y, BindPopup.W, BindPopup.H) then
                    for _, row in ipairs(BindPopup.Rows) do
                        local ry = BindPopup.Y + row.YOffset
                        if IsMouseOver(mPos, BindPopup.X, ry, BindPopup.W, 16) then
                            if BindPopup.TargetBind then
                                BindPopup.TargetBind.BindMode = row.Name
                                if row.Name == "always on" then
                                    BindPopup.TargetBind.State = true
                                elseif row.Name == "always off" then
                                    BindPopup.TargetBind.State = false
                                end
                                BindPopup.TargetBind.BoxFill.Color = BindPopup.TargetBind.State and Library.Theme.TextActive or Library.Theme.ControlBg
                                BindPopup.TargetBind.Txt.Color = BindPopup.TargetBind.State and Library.Theme.TextWhite or Library.Theme.TextDim
                                if BindPopup.TargetBind.Callback then BindPopup.TargetBind.Callback(BindPopup.TargetBind.State) end
                            end
                            CloseBindPopup()
                            RefreshLayout()
                            return
                        end
                    end
                    return
                else
                    CloseBindPopup()
                end
            end

            local curPage = Window.Pages[Window.ActiveTab]
            if curPage then
                local function CheckDropdownClick(it)
                    if it.Type == "Dropdown" and it.Open then
                        for _, opt in ipairs(it.OptItems) do
                            if opt.AbsX and IsMouseOver(mPos, opt.AbsX, opt.AbsY, opt.AbsW, opt.AbsH) then
                                it.Selected = opt.Name
                                it.Open = false
                                if it.Callback then it.Callback(opt.Name) end
                                RefreshLayout()
                                return true
                            end
                        end
                        it.Open = false
                        RefreshLayout()
                        return true
                    end
                    if it.Type == "Checkbox" and it.State and it.SubItems then
                        for _, sub in ipairs(it.SubItems) do
                            if CheckDropdownClick(sub) then return true end
                        end
                    end
                    return false
                end

                for _, sideList in ipairs({ curPage.Left, curPage.Right }) do
                    for _, sec in ipairs(sideList) do
                        for _, it in ipairs(sec.Items) do
                            if CheckDropdownClick(it) then return end
                        end
                    end
                end
            end

            for _, tb in ipairs(Window.Tabs) do
                local bx = MenuX + tb.RelX - 12
                local by = MenuY + tb.RelY - 8
                local bw = tb.W + 24
                local bh = tb.H + 16
                if IsMouseOver(mPos, bx, by, bw, bh) then
                    if Window.ActiveTab ~= tb.Name then
                        Window.ActiveTab = tb.Name
                        for _, b in ipairs(Window.Tabs) do
                            b.Item.Color = (b.Name == Window.ActiveTab) and Library.Theme.TextActive or Library.Theme.TextDim
                        end
                        MoveActiveTabGlow(tb.Item, tb.RelX)
                        CloseBindPopup()
                        CloseColorPicker()
                        CloseColorMenuPopup()
                        RefreshLayout()
                    end
                    return
                end
            end

            if curPage then
                for _, sideList in ipairs({ curPage.Left, curPage.Right }) do
                    for _, sec in ipairs(sideList) do
                        for _, it in ipairs(sec.Items) do
                            if HandleItemInteraction(mPos, it) then return end
                        end
                    end
                end
            end

            if IsMouseOver(mPos, MenuX, MenuY, MenuW, 36) then
                isDragging = true
                dragOffset = Vector2.new(mPos.X - MenuX, mPos.Y - MenuY)
                CloseBindPopup()
                CloseColorPicker()
                CloseColorMenuPopup()
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = false
            ActiveSlider = nil
            ColorPickerWin.DraggingSV = false
            ColorPickerWin.DraggingH = false
        else
            local relInput = nil
            if input.UserInputType == Enum.UserInputType.Keyboard then
                relInput = input.KeyCode.Name
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
                relInput = input.UserInputType.Name
            end
            if relInput then
                for _, p in pairs(Window.Pages) do
                    for _, sideList in ipairs({ p.Left, p.Right }) do
                        for _, sec in ipairs(sideList) do
                            for _, it in ipairs(sec.Items) do
                                if it.Type == "Checkbox" and it.BindKey == relInput and it.BindMode == "hold" then
                                    it.State = false
                                    it.BoxFill.Color = Library.Theme.ControlBg
                                    it.Txt.Color = Library.Theme.TextDim
                                    if it.Callback then it.Callback(false) end
                                    RefreshLayout()
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    RunService.RenderStepped:Connect(function()
        if not Library.MenuOpen then return end
        local mPos = GetExactMouse()

        if ColorPickerWin.Visible then
            if ColorPickerWin.DraggingSV then
                ColorPickerWin.S_Val = math.clamp((mPos.X - (ColorPickerWin.X + 8)) / 105, 0, 1)
                ColorPickerWin.V_Val = 1 - math.clamp((mPos.Y - (ColorPickerWin.Y + 8)) / 105, 0, 1)
                UpdateColorPickerVisuals(false)
            elseif ColorPickerWin.DraggingH then
                ColorPickerWin.H_Val = 1 - math.clamp((mPos.Y - (ColorPickerWin.Y + 8)) / 96, 0, 1)
                UpdateColorPickerVisuals(true)
            end
        end

        if isDragging then
            MenuX = math.floor(mPos.X - dragOffset.X)
            MenuY = math.floor(mPos.Y - dragOffset.Y)

            fOuter.Position = Vector2.new(MenuX, MenuY)
            fMid.Position   = Vector2.new(MenuX + 1, MenuY + 1)
            fGap.Position   = Vector2.new(MenuX + 2, MenuY + 2)
            fIn.Position    = Vector2.new(MenuX + 5, MenuY + 5)
            fBg.Position    = Vector2.new(MenuX + 6, MenuY + 6)
            headerSep.Position = Vector2.new(MenuX + 14, MenuY + 36)

            local exactW = math.max(38, math.floor(tLogo1.TextBounds.X) + 1)
            tLogo1.Position = Vector2.new(MenuX + 18, MenuY + 14)
            tLogo2.Position = Vector2.new(MenuX + 18 + exactW, MenuY + 14)

            for _, seg in ipairs(topBorderGlow) do seg.Obj.Position = Vector2.new(MenuX + seg.RelX, MenuY + seg.RelY) end
            for _, seg in ipairs(botBorderGlow) do seg.Obj.Position = Vector2.new(MenuX + seg.RelX, MenuY + seg.RelY) end
            for _, seg in ipairs(mainHeaderGlow) do seg.Obj.Position = Vector2.new(MenuX + seg.RelX, MenuY + seg.RelY) end

            for _, tb in ipairs(Window.Tabs) do tb.Item.Position = Vector2.new(MenuX + tb.RelX, MenuY + tb.RelY) end
            for _, seg in ipairs(activeTabGlowSegs) do
                if seg.Obj.Visible then seg.Obj.Position = Vector2.new(MenuX + seg.RelX, MenuY + seg.RelY) end
            end

            RefreshLayout()
        end

        if ActiveSlider then
            local barW = ActiveSlider.AbsW - 36
            local pct = math.clamp((mPos.X - (ActiveSlider.AbsX + 18)) / barW, 0, 1)
            local raw = ActiveSlider.Min + (ActiveSlider.Max - ActiveSlider.Min) * pct
            local stepped = math.floor(raw / ActiveSlider.Step + 0.5) * ActiveSlider.Step
            stepped = math.clamp(stepped, ActiveSlider.Min, ActiveSlider.Max)
            if ActiveSlider.Val ~= stepped then
                ActiveSlider.Val = stepped
                ActiveSlider.ValTxt.Text = ActiveSlider.Format(stepped)
                if ActiveSlider.Callback then ActiveSlider.Callback(stepped) end
                RefreshLayout()
            end
        end
    end)

    return Window
end

return Library
