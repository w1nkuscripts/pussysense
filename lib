    local function MoveActiveTabGlow(btnObj, btnRelX)
        local actualW = math.floor(btnObj.TextBounds.X)
        if actualW <= 0 then actualW = #btnObj.Text * 7 end
        local padding = 12
        local targetW = actualW + (padding * 2)
        local startX = btnRelX + math.floor((actualW - targetW) / 2)

        for i = 1, maxGlowPool do
            local seg = activeTabGlowSegs[i]
            if i <= targetW then
                local p = (targetW > 1) and ((i - 1) / (targetW - 1)) or 0.5
                local inten = (math.sin(p * math.pi)) ^ 2.0
                local col = (inten < 0.5)
                    and Library.Theme.MainBg:Lerp(Library.Theme.GlowMid, inten * 1.8)
                    or Library.Theme.GlowMid:Lerp(Library.Theme.GlowCore, (inten - 0.5) * 2)

                seg.Obj.Color = col
                seg.RelX = startX + (i - 1)
                seg.RelY = 35
                seg.Obj.Position = Vector2.new(MenuX + seg.RelX, MenuY + seg.RelY)
                seg.Obj.Visible = true
            else
                seg.Obj.Visible = false
            end
        end
    end

