    local function HideItem(it)
        it.AbsX, it.AbsY = nil, nil
        if it.Type == "Checkbox" then
            it.BoxOut.Visible, it.BoxIn.Visible, it.BoxFill.Visible, it.Txt.Visible = false, false, false, false
            if it.BindBtn then it.BindBtn.Visible = false end
            if it.Picker then
                it.Picker.BoxX = nil
                it.Picker.BoxOut.Visible, it.Picker.BoxIn.Visible, it.Picker.BoxFill.Visible = false, false, false
            end
            if it.SubItems then
                for _, sub in ipairs(it.SubItems) do HideItem(sub) end
            end
        elseif it.Type == "Keybind" then
            it.Txt.Visible, it.BindBtn.Visible = false, false
        elseif it.Type == "Button" then
            it.BoxOut.Visible, it.BoxIn.Visible, it.BoxBg.Visible, it.Txt.Visible = false, false, false, false
        elseif it.Type == "ButtonRow" then
            for _, btn in ipairs(it.Buttons) do
                btn.BoxOut.Visible, btn.BoxIn.Visible, btn.BoxBg.Visible, btn.Txt.Visible = false, false, false, false
            end
        elseif it.Type == "ScrollList" then
            it.BoxOut.Visible, it.BoxIn.Visible, it.BoxBg.Visible = false, false, false
            for _, row in ipairs(it.Rows) do row.Txt.Visible = false end
        elseif it.Type == "Textbox" then
            it.LblTxt.Visible, it.BoxOut.Visible, it.BoxIn.Visible, it.BoxBg.Visible, it.ValTxt.Visible = false, false, false, false, false
        elseif it.Type == "ColorPicker" then
            it.BoxX = nil
            it.Txt.Visible = false
            it.BoxOut.Visible, it.BoxIn.Visible, it.BoxFill.Visible = false, false, false
        elseif it.Type == "Dropdown" then
            it.LblTxt.Visible = false
            it.BoxOut.Visible, it.BoxIn.Visible, it.BoxBg.Visible = false, false, false
            it.ValTxt.Visible, it.ArrowTxt.Visible = false, false
            for _, opt in ipairs(it.OptItems) do
                opt.AbsX = nil
                opt.Out.Visible, opt.In.Visible, opt.Bg.Visible, opt.Txt.Visible = false, false, false, false
            end
            if it.ConditionalSubs then
                for _, subList in pairs(it.ConditionalSubs) do
                    for _, sub in ipairs(subList) do HideItem(sub) end
                end
            end
        elseif it.Type == "Slider" then
            it.Txt.Visible, it.ValTxt.Visible, it.BarOut.Visible, it.BarIn.Visible, it.BarFill.Visible = false, false, false, false, false
            it.BtnMinusOut.Visible, it.BtnMinusIn.Visible, it.BtnMinusBg.Visible, it.BtnMinusTxt.Visible = false, false, false, false
            it.BtnPlusOut.Visible, it.BtnPlusIn.Visible, it.BtnPlusBg.Visible, it.BtnPlusTxt.Visible = false, false, false, false
            if it.Picker then
                it.Picker.BoxX = nil
                it.Picker.BoxOut.Visible, it.Picker.BoxIn.Visible, it.Picker.BoxFill.Visible = false, false, false
            end
        end
    end

    local function HideSection(sec)
